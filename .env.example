# ===== 数据库 =====
# Postgres 密码（compose 里必填，缺失会直接报错退出）
POSTGRES_PASSWORD=change_me_strong_password

# 宿主机直连用（端口 5433 对应 docker-compose 的映射）
DATABASE_URL=postgresql+asyncpg://lc:change_me_strong_password@127.0.0.1:5433/lc_course
# Alembic 迁移用的同步驱动连接串
DATABASE_URL_SYNC=postgresql+psycopg://lc:change_me_strong_password@127.0.0.1:5433/lc_course

REDIS_URL=redis://127.0.0.1:6380/0

# ===== 认证 =====
# 生产环境务必替换为随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_random_long_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=4320

# ===== 大模型 / 搜索 =====
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
TAVILY_API_KEY=tvly-your-tavily-key
# HuggingFace 国内镜像（本地向量模型下载用）
HF_ENDPOINT=https://hf-mirror.com

# ===== 阿里云 OSS（图片直传）=====
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=your-bucket
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
